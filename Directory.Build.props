<Project>
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>13.0</LangVersion>
        <Nullable>enable</Nullable>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <!-- <ImplicitUsings>enable</ImplicitUsings> -->
        <ImplicitUsings>disable</ImplicitUsings>
        <WarningsAsErrors/>
        <WarningsNotAsErrors>CS1591</WarningsNotAsErrors>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
        <!-- Feature/test/legacy-host projects compile but never produce separate publish folders. -->
        <IsPublishable Condition="'$(MSBuildProjectName)' != 'unscience'">false</IsPublishable>

    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
        <DefineConstants>DEBUG;TRACE</DefineConstants>
        <DebugType>full</DebugType>
        <DebugSymbols>true</DebugSymbols>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <DefineConstants>TRACE</DefineConstants>
        <DebugType>pdbonly</DebugType>
        <Optimize>true</Optimize>
    </PropertyGroup>

    <!--
        ===== KSA game paths =====

        KSAFolder — directory containing the KSA reference assemblies (KSA.dll,
        Brutal.*.dll, Planet.*.dll) the projects compile against. Resolution
        order, first match wins; every tier works on any host OS:

          1. KSA_DLL_DIR env var (or -p:KSA_DLL_DIR=...). This is what CI uses.
          2. A `ksa-game-assemblies` checkout cloned NEXT TO this repo
             (DLLs in its current/dll/ folder) — clone-and-go, no config.
          3. Per-OS developer defaults (game install on Windows; the
             ksa-game-assemblies checkout on macOS/Linux).

        The KSA DLLs are proprietary and never committed here; every project in
        this repo compiles against them via `$(KSAFolder)` HintPaths.

        SelectedDistModDir — where each built mod folder is deployed (each mod
        project appends its own folder, e.g. unscience/). Override with
        UNSCIENCE_DIST_DIR (CI zips <that>/unscience); defaults to the per-OS
        KSA mods dir.
    -->
    <PropertyGroup>
        <KSAFolder Condition="'$(KSAFolder)' == '' AND '$(KSA_DLL_DIR)' != ''">$([MSBuild]::EnsureTrailingSlash('$(KSA_DLL_DIR)'))</KSAFolder>
        <KSAFolder Condition="'$(KSAFolder)' == '' AND Exists('$(MSBuildThisFileDirectory)../ksa-game-assemblies/current/dll/')">$(MSBuildThisFileDirectory)../ksa-game-assemblies/current/dll/</KSAFolder>
        <KSAFolder Condition="'$(KSAFolder)' == '' AND '$(OS)' == 'Windows_NT'">C:\Program Files\Kitten Space Agency\</KSAFolder>
        <KSAFolder Condition="'$(KSAFolder)' == ''">$(HOME)/repos/meow-sci/ksa-game-assemblies/current/dll/</KSAFolder>

        <KSAUserDir Condition="'$(KSAUserDir)' == '' AND '$(OS)' == 'Windows_NT'">$(USERPROFILE)\Documents\My Games\Kitten Space Agency\</KSAUserDir>
        <KSAUserDir Condition="'$(KSAUserDir)' == ''">$(HOME)/repos/meow-sci/mods/</KSAUserDir>

        <!-- mods -->
        <KSAUserModDir>$(KSAUserDir)mods\</KSAUserModDir>
        <KSAProgramFilesModDir>$(KSAFolder)Content\</KSAProgramFilesModDir>
        <SelectedDistModDir Condition="'$(SelectedDistModDir)' == '' AND '$(UNSCIENCE_DIST_DIR)' != ''">$([MSBuild]::EnsureTrailingSlash('$(UNSCIENCE_DIST_DIR)'))</SelectedDistModDir>
        <!-- <SelectedDistModDir Condition="'$(SelectedDistModDir)' == ''">$(KSAProgramFilesModDir)</SelectedDistModDir> -->
        <SelectedDistModDir Condition="'$(SelectedDistModDir)' == ''">$(KSAUserModDir)</SelectedDistModDir>
    </PropertyGroup>

    <!-- Every project here references the KSA assemblies through condition-guarded
         HintPaths, so a missing/misresolved KSAFolder would otherwise surface as a
         CS0246 avalanche. Fail early with one actionable error instead. A project
         that genuinely doesn't need the game can set RequiresKSAAssemblies=false. -->
    <PropertyGroup>
        <RequiresKSAAssemblies Condition="'$(RequiresKSAAssemblies)' == ''">true</RequiresKSAAssemblies>
    </PropertyGroup>
    <Target Name="ValidateKSAAssemblies" BeforeTargets="ResolveAssemblyReferences"
            Condition="'$(RequiresKSAAssemblies)' == 'true' AND !Exists('$(KSAFolder)KSA.dll')">
        <Error Text="KSA reference assemblies not found: '$(KSAFolder)KSA.dll' does not exist. Set the KSA_DLL_DIR environment variable (or pass -p:KSA_DLL_DIR=...), or clone meow-sci/ksa-game-assemblies next to this repo (DLLs under current/dll/). Resolution order is documented in Directory.Build.props."/>
    </Target>
</Project>
